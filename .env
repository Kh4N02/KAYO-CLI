# AU Webshare proxy — host:port:username:password (any AU endpoint works)
KAYO_PROXY=92.112.162.186:8364:nqhsasvr:tjv4knjiifck

# Local VPN/Clash HTTP port (forwards to KAYO_PROXY). N_m3u8DL uses this when set.
KAYO_PROXY_TUNNEL=127.0.0.1:7897
KAYO_BROWSER_PROXY=1

# Friends without a local tunnel: omit KAYO_PROXY_TUNNEL and set only KAYO_PROXY above.
# Optional: try Webshare after tunnel for N_m3u8DL (tunnel is default when KAYO_PROXY_TUNNEL is set):
# KAYO_DOWNLOAD_USE_DIRECT=1

# Override download proxy only (host:port:user:pass, or 0 to omit --custom-proxy)
# KAYO_DOWNLOAD_PROXY=

# Kayo login — used for browser fallback when no token can be refreshed
KAYO_EMAIL=s.minchington1@optusnet.com.au
KAYO_PASSWORD=Trustno-1

# Optional: paste Bearer from Chrome Network tab (RefreshAccessToken / any indazn.com request)
# KAYO_TOKEN=eyJ...

# Show Chrome during login + WAF (recommended). Use 1 for headless only.
KAYO_BROWSER_HEADLESS=0

# --- Python (UniDL package + CDN bridge) — use 3.11 where unidl.exe is installed ---
KAYO_PYTHON=C:\Users\ozair\AppData\Local\Programs\Python\Python311\python.exe

# --- All outputs under this repo (nothing on C:\Users\ozair\Downloads by default) ---
KAYO_DOWNLOAD_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\downloads
KAYO_UNIDL_COMMANDS_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\unidl-commands
KAYO_UNIDL_TMP_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\tmp
# WSL live --live-pipe-mux: FIFO temp must be native Linux (default ~/.cache/kayo-unidl/tmp), not /mnt/d
# KAYO_UNIDL_WSL_TMP_DIR=/home/ozair/.cache/kayo-unidl/tmp
KAYO_UNIDL_LOG_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\logs

# --- Downloader: UniDL (VOD + live record via WSL pipe-mux) ---
KAYO_DOWNLOADER=unidl
KAYO_LIVE_DOWNLOADER=unidl
KAYO_UNIDL=headless

# Live record → Ubuntu (FIFO merge). save+both writes scripts under unidl-commands/
KAYO_UNIDL_WSL=auto
KAYO_UNIDL_WSL_DISTRO=Ubuntu
# both = Windows cmd + save .sh | save = Ubuntu `kayo` only (bridge still starts from kayo_cmd)
KAYO_UNIDL_WSL_LAUNCH=save
# CDN bridge listen address on Windows (default 0.0.0.0 so WSL can use host IP from resolv.conf)
# KAYO_BRIDGE_BIND=0.0.0.0
# unidl on PATH in WSL (~/.local/bin). Uncomment only if you use a venv:
# KAYO_UNIDL_WSL_VENV=/home/ozair/.venv

# Live Kayo is HEVC — UniDL pipe-mux usually needs mkv (ts often fails). HBO-style ts works for H.264 live.
KAYO_UNIDL_LIVE_MUX_FORMAT=mkv
KAYO_UNIDL_VOD_MUX_FORMAT=mp4
KAYO_UNIDL_HTTP_TIMEOUT=30
# Live edge: 1 segment per refresh (default UniDL take=16 buffers ~30–40s). Wait = MPD poll seconds.
KAYO_UNIDL_LIVE_TAKE_COUNT=1
KAYO_UNIDL_LIVE_WAIT_TIME=2
KAYO_UNIDL_EXTRA=--workers 16 --retries 5
# Pick tracks in UniDL console when prompted (e.g. 1,9). Or fixed:
# KAYO_UNIDL_SELECT=1,9
# KAYO_UNIDL_LIVE_KEEP_TEMP=1

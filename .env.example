# AU Webshare proxy — host:port:username:password
KAYO_PROXY=host:port:user:pass

# Local Clash HTTP port (forwards to KAYO_PROXY). Used for API refresh + N_m3u8DL.
KAYO_PROXY_TUNNEL=127.0.0.1:7897

# Playwright WAF / UHD browser playback — use Clash HTTP (kayosports.com.au loads; set if WAF fails):
# KAYO_BROWSER_PROXY=127.0.0.1:7897

# Pick Kayo household profile with working 4K playback (SignIn + SwitchProfile + probe):
# KAYO_SWITCH_HOUSEHOLD_PROFILE=1
# PlayReady device (default SL2000 for 4K): cmds/hisense_smarttv_hu32e5600fhwv_sl2000.prd
# KAYO_PLAYREADY_PRD=cmds/hisense_smarttv_hu32e5600fhwv_sl2000.prd

# Replay / UHD lists are cached on disk (~24h). Stale cricket replays? Refresh once:
# KAYO_REFRESH_CACHE=1
# KAYO_CACHE_HOURS=24

# VOD CDN preference (like “switch CDN” in debrid apps): ac-vod | fs-vod
# KAYO_VOD_CDN=ac-vod

# Key order for UHD webos-widevine: default Widevine L1 first, then PlayReady .prd. Force one DRM:
# KAYO_DRM_FIRST=playready
# KAYO_DRM_FIRST=widevine

# Browser login (Playwright): ExpressVPN / Nord etc — use system VPN, not Clash HTTP proxy:
# KAYO_BROWSER_NO_PROXY=1
# Or try Webshare before tunnel when Clash misroutes DAZN auth:
# KAYO_BROWSER_PREFER_TUNNEL=0
# Show Chrome during login (recommended when auth fails):
# KAYO_BROWSER_HEADLESS=0

# Kayo login (used if kayo-token.json expires)
KAYO_EMAIL=your@email.com
KAYO_PASSWORD=yourpassword

# Python for local DRM keys (cmds/*.prd + *.wvd).
# Auto-detects: py -3, py, python, python3 (needs Python 3.10+).
# Override if auto-detect fails, e.g.:
# KAYO_PYTHON=python
# KAYO_PYTHON=py -3.13
# KAYO_PYTHON=C:\Python312\python.exe

# 4K default: webOS TV + Widevine + 4k cap only (no multi-profile sweep).
# Override profile: KAYO_UHD_PROFILE=webos-widevine
# Old behaviour (probe every TV profile): KAYO_UHD_PROBE_ALL=1
# Open Chrome for 4K when curl gets 403 (default: fail fast with same token): KAYO_UHD_BROWSER_WAF=1

# Downloader: nm3u8dl | python | unidl | unshackle
# KAYO_DOWNLOADER=nm3u8dl
# KAYO_DOWNLOADER=python
# KAYO_DOWNLOADER=unidl
# KAYO_UNIDL=headless
# KAYO_UNIDL=tui
# KAYO_UNIDL_EXE=unidl
# Headless runs: unidl download <bridge-mpd-url> --key … (see `unidl download --help`)
# KAYO_UNIDL_EXTRA=--workers 16 --retries 5 --tmp-dir D:\WEB-DL Tools\unidl\tmp
# KAYO_DOWNLOADER=unshackle
# KAYO_UNSHACKLE=D:\Cricket Matches-Shots\Scripts\apple-tv_(fox4k)\unshackle
# KAYO_UNSHACKLE_EXE=
# KAYO_UNSHACKLE_REGION=AU
# KAYO_BRIDGE_PORT=17890

# Optional: full path to N_m3u8DL-RE / cmd.exe if not on PATH (same as Kayo Jinx D:\Tools\cmd.exe)
# KAYO_NM3U8DL=D:\Tools\N_m3u8DL-RE.exe
# KAYO_CMD_EXE=D:\Tools\cmd.exe
# KAYO_DOWNLOAD_DIR=D:\Cricket Matches-Shots\Downloads

# AU Webshare proxy — host:port:username:password
KAYO_PROXY=host:port:user:pass

# Local Clash HTTP port (forwards to KAYO_PROXY). Used for API refresh + N_m3u8DL.
KAYO_PROXY_TUNNEL=127.0.0.1:7897

# Playwright WAF / UHD browser playback — use Clash HTTP (kayosports.com.au loads; set if WAF fails):
# KAYO_BROWSER_PROXY=127.0.0.1:7897

# Pick Kayo household profile with working 4K playback (SignIn + SwitchProfile + probe):
# KAYO_SWITCH_HOUSEHOLD_PROFILE=1
# PlayReady device (default SL2000 for 4K): cmds/hisense_smarttv_hu32e5600fhwv_sl2000.prd
# KAYO_PLAYREADY_PRD=cmds/hisense_smarttv_hu32e5600fhwv_sl2000.prd

# Replay / UHD lists are cached on disk (~24h). Stale cricket replays? Refresh once:
# KAYO_REFRESH_CACHE=1
# KAYO_CACHE_HOURS=24

# VOD/live downloads use dck1-ac-vod / dck1-ac-live only (faster, higher bitrate).
# Escape hatch if AC fails: KAYO_VOD_CDN=fs-vod
# KAYO_VOD_CDN=ac-vod

# UHD / 4K (Premium allow4k): PlayReady web profile first — ac-vod MPD + PlayReady license as manual 4K WEB-DL
# KAYO_UHD_PLAYREADY_FIRST=1
# KAYO_UHD_PROFILE=web-playready-4k-cap
# KAYO_DRM_FIRST=playready
# PlayReady 4K API 403 from curl but friend works? Chrome cookie playback:
# KAYO_UHD_BROWSER_WAF=1
# KAYO_UHD_AUTO_BROWSER=1
# KAYO_UHD_WIDEVINE_FALLBACK=1
# KAYO_UNIDL_UHD_SELECT=res=2160:for=best
# Key order for UHD webos-widevine fallback: Widevine L1 first unless KAYO_DRM_FIRST=playready
# KAYO_DRM_FIRST=widevine

# Browser login (Playwright): ExpressVPN / Nord etc — use system VPN, not Clash HTTP proxy:
# KAYO_BROWSER_NO_PROXY=1
# Or try Webshare before tunnel when Clash misroutes DAZN auth:
# KAYO_BROWSER_PREFER_TUNNEL=0
# Show Chrome during login (recommended when auth fails):
# KAYO_BROWSER_HEADLESS=0

# Kayo login (used if kayo-token.json expires)
KAYO_EMAIL=your@email.com
KAYO_PASSWORD=yourpassword

# Python for local DRM keys (cmds/*.prd + *.wvd).
# Auto-detects: py -3, py, python, python3 (needs Python 3.10+).
# Override if auto-detect fails, e.g.:
# KAYO_PYTHON=python
# KAYO_PYTHON=py -3.13
# KAYO_PYTHON=C:\Python312\python.exe

# 4K default: webOS TV + Widevine + 4k cap only (no multi-profile sweep).
# Override profile: KAYO_UHD_PROFILE=webos-widevine
# Old behaviour (probe every TV profile): KAYO_UHD_PROBE_ALL=1
# Open Chrome for 4K when curl gets 403 (default: fail fast with same token): KAYO_UHD_BROWSER_WAF=1

# Downloader: nm3u8dl | python | unidl | unshackle
# KAYO_DOWNLOADER=nm3u8dl
# KAYO_DOWNLOADER=python
# KAYO_DOWNLOADER=unidl
# KAYO_UNIDL=headless
# KAYO_UNIDL=tui
# KAYO_UNIDL_EXE=unidl
# Live TV "Record live" (pipe-mux): use UniDL even when VOD uses nm3u8dl:
# KAYO_LIVE_DOWNLOADER=unidl
# Live record on Windows: --live-pipe-mux needs WSL (auto). Disable: KAYO_UNIDL_WSL=0
# KAYO_UNIDL_WSL=auto
# wsl = auto-open Ubuntu | save = only write ~/.unidl/commands/kayo | both = save + WSL (default)
# KAYO_UNIDL_WSL_LAUNCH=both
# KAYO_UNIDL_COMMANDS_DIR=C:\Users\you\.unidl\commands\kayo
# KAYO_UNIDL_WSL_DISTRO=Ubuntu
# KAYO_WSL_EXE=C:\Program Files\WSL\wsl.exe
# Python venv inside WSL where `unidl` is installed (HBO-style):
# KAYO_UNIDL_WSL_VENV=/home/you/.venv
# Headless: opens UniDL in a console — you choose tracks (1,9 etc.), not auto -sv/-sa.
# KAYO_UNIDL_AUTO_SELECT=1  # skip prompt, pick best A/V
# KAYO_UNIDL_SELECT=1,9     # fixed tracks (no prompt)
# Live record: save name includes timestamp (Live_Match_20261011_144530.mkv) under <title>_live/
# KAYO_UNIDL_EXTRA=--workers 16 --retries 5 --http-request-timeout 30
# KAYO_UNIDL_TMP_DIR=D:\WEB-DL Tools\unidl\tmp
# KAYO_UNIDL_LOG_DIR=D:\WEB-DL Tools\unidl\logs
# KAYO_UNIDL_LIVE_KEEP_TEMP=1   # --keep-temp --no-del-after-done while recording live
# After successful live UniDL (exit 0), delete ~/.cache/kayo-unidl/tmp/<job>* (WSL). Off: KAYO_UNIDL_CLEAN_TMP=0
# KAYO_UNIDL_CLEAN_TMP=1
# KAYO_UNIDL_LIVE_TAKE_COUNT=1  # UniDL default 16 buffers many segments (~30–40s) before mux
# KAYO_UNIDL_LIVE_WAIT_TIME=2   # MPD refresh interval (seconds); lower = snappier live edge
# KAYO_UNIDL_LIVE_MUX_FORMAT=mkv  # Kayo HEVC live pipe-mux; ts is for H.264-style (HBO) streams
# Kayo replays: AC-3 / subs — mp4 mux often fails; default mkv + mkvmerge
# KAYO_UNIDL_VOD_MUX_FORMAT=mkv
# KAYO_UNIDL_MUXER=mkvmerge
# KAYO_DOWNLOADER=unshackle
# KAYO_UNSHACKLE=D:\Cricket Matches-Shots\Scripts\apple-tv_(fox4k)\unshackle
# KAYO_UNSHACKLE_EXE=
# KAYO_UNSHACKLE_REGION=AU
# KAYO_BRIDGE_PORT=17890
# CDN bridge upstream: uses KAYO_PROXY_TUNNEL (Clash HTTP) by default when set — fixes manifest 403 without TUN.
# KAYO_BRIDGE_DIRECT=1
# Reuse bridge on KAYO_BRIDGE_PORT only when CDN origin matches (live catchup + live record OK; VOD gets another port)
# KAYO_BRIDGE_REUSE=1
# KAYO_BRIDGE_PROBE=0
# Kill old bridge on KAYO_BRIDGE_PORT before starting (off by default — avoids killing live bridge)
# KAYO_BRIDGE_KILL_STALE=1

# Optional: full path to N_m3u8DL-RE / cmd.exe if not on PATH (same as Kayo Jinx D:\Tools\cmd.exe)
# KAYO_NM3U8DL=D:\Tools\N_m3u8DL-RE.exe
# KAYO_CMD_EXE=D:\Tools\cmd.exe
# Keep everything under kayo_cmd (recommended):
# KAYO_DOWNLOAD_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\downloads
# KAYO_UNIDL_COMMANDS_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\unidl-commands
# KAYO_UNIDL_TMP_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\tmp
# KAYO_UNIDL_LOG_DIR=D:\Cricket Matches-Shots\Scripts\kayo_cmd\logs
